// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  Manager
  Staff
}

enum OrderStatus {
  Pending
  Processing
  Shipped
  Delivered
  Cancelled
}

enum PayementStatus {
  Pending
  Success
  Failed
  Refunded
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password_hash String
  role          Role     @default(Staff)
  status        Boolean  @default(false)
  created_at    DateTime @default(now())

  order                 Order[]
  auditLogs             AuditLog[]      @relation("AuditLogActor")
  stockMovementsCreated StockMovement[] @relation("StockMovementCreator")

  @@map("users")
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  @@map("tags")
}

model Keyword {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  @@map("keywords")
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  description String   @db.VarChar(500)
  categoryId  Int      @map("categories_id")
  price       Int
  costPrice   Int
  imageUrl    String
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  category       Category        @relation(fields: [categoryId], references: [id])
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  tags           Tag[]
  keywords       Keyword[]

  @@map("products")
}

model Category {
  id                 Int        @id @default(autoincrement())
  name               String
  parent_category_id Int
  parentCategory     Category   @relation("CategoryParent", fields: [parent_category_id], references: [id])
  children           Category[] @relation("CategoryParent")
  products           Product[]

  @@map("categories")
}

model StockMovement {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  movement_type String
  quantity      Int
  refrence_type String   @map("refrence_type")
  refrence_id   Int      @map("refrence_id")
  note          String
  created_by    Int
  created_at    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  creator User    @relation("StockMovementCreator", fields: [created_by], references: [id])

  @@map("stock_movements")
}

model Order {
  id             Int      @id @default(autoincrement())
  order_number   Int      @unique
  userId         Int      @map("Users_id")
  customer_name  String
  total_amount   Int
  payment_status Boolean
  order_status   Boolean
  created_At     DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@map("orders")
}

model OrderItem {
  id         Int @id @default(autoincrement())
  orderId    Int @map("order_id")
  productId  Int @map("product_id")
  quantity   Int
  unit_price Int
  subtotal   Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id                  Int      @id @default(autoincrement())
  orderId             Int      @map("order_id")
  provider            String
  provider_payment_id String
  amount              Int
  currency            String
  status              String
  created_at          DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int      @map("actor_id")
  action      String
  entity_type String
  entity_id   Int
  metadata    Json
  created_at  DateTime @default(now())
  actor       User     @relation("AuditLogActor", fields: [actorId], references: [id])

  @@map("audit_logs")
}
